{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final_holdout_execution_record_v1",
  "title": "Final holdout one-shot execution record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "run_id",
    "started_at_utc",
    "ended_at_utc",
    "exact_command",
    "exit_code",
    "frozen_production_git_commit",
    "extraction_config_id",
    "model_provider",
    "model_name",
    "source_snapshot_identity",
    "holdout_artifact_identity",
    "extraction_output_identity",
    "stdout_log_path",
    "stderr_log_path",
    "python_version",
    "uv_lock_sha256",
    "model_usage",
    "incident_retry_notes",
    "manual_intervention_before_primary_freeze",
    "primary_predictions_frozen_at_utc"
  ],
  "properties": {
    "record_version": {
      "const": "final_holdout_execution_record_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "exact_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exit_code": {
      "type": "integer"
    },
    "frozen_production_git_commit": {
      "const": "282de815bea4e248bdcba2c655e3ee078cb58a49"
    },
    "extraction_config_id": {
      "const": "4b54b89dbfe8640e"
    },
    "model_provider": {
      "const": "gemini"
    },
    "model_name": {
      "const": "google:gemini-2.5-flash"
    },
    "source_snapshot_identity": {
      "const": "1d3eec6ac15e293dbd83c80d8c8504b3d425e1fb07d8e84b8cfbb0ebbd659cbf"
    },
    "holdout_artifact_identity": {
      "$ref": "#/$defs/sha256"
    },
    "extraction_output_identity": {
      "$ref": "#/$defs/sha256"
    },
    "stdout_log_path": {
      "type": "string",
      "minLength": 1
    },
    "stderr_log_path": {
      "type": "string",
      "minLength": 1
    },
    "python_version": {
      "type": "string",
      "minLength": 1
    },
    "uv_lock_sha256": {
      "const": "af47371305913f4913c05a73448a8be92f44fbceb3f604b491d629cc80639229"
    },
    "model_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "requests": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "input_tokens": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "output_tokens": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "total_tokens": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "incident_retry_notes": {
      "type": "string",
      "minLength": 1
    },
    "manual_intervention_before_primary_freeze": {
      "const": false
    },
    "primary_predictions_frozen_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
